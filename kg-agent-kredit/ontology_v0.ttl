# Ontology v0: AI Agent Compliance
@prefix ac:   <https://example.org/agent-compliance#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://example.org/agent-compliance> a owl:Ontology ;
    rdfs:label "Ontology AI Agent Compliance"@id ;
    owl:versionInfo "v0, 8 November 2026" ;
    rdfs:comment "Ontology untuk compliance risk assessment AI agent dari documentation, code, dan log."@id .

# Class
ac:Agent a owl:Class ; rdfs:label "agent"@en ; rdfs:comment "Sistem AI berbasis LLM yang bisa memanggil tool untuk bertindak. Inilah yang dinilai."@id ; ac:group "Sistem" .
ac:Tool a owl:Class ; rdfs:label "tool"@en ; rdfs:comment "Kemampuan yang bisa dipanggil agent untuk melakukan sesuatu di luar dirinya."@id ; ac:group "Sistem" .
ac:Purpose a owl:Class ; rdfs:label "purpose"@en ; rdfs:comment "Untuk apa agent dipakai. Purpose menentukan risk class."@id ; ac:group "Sistem" .
ac:Action a owl:Class ; rdfs:label "action"@en ; rdfs:comment "Satu kali agent memanggil tool. Setiap action tercatat di log."@id ; ac:group "Operasi" .
ac:Session a owl:Class ; rdfs:label "session"@en ; rdfs:comment "Satu sesi agent berjalan, berisi beberapa action."@id ; ac:group "Operasi" .
ac:Approval a owl:Class ; rdfs:label "approval"@en ; rdfs:comment "Persetujuan manusia sebelum action dijalankan."@id ; ac:group "Operasi" .
ac:Evidence a owl:Class ; rdfs:label "evidence"@en ; rdfs:comment "Satu pernyataan tentang agent atau tool yang diambil dari source, lengkap dengan provenance dan confidence."@id ; ac:group "Evidence" .
ac:Source a owl:Class ; rdfs:label "source"@en ; rdfs:comment "Tempat evidence diambil: documentation, code, atau log."@id ; ac:group "Evidence" .
ac:Documentation a owl:Class ; rdfs:label "documentation"@en ; rdfs:comment "Deskripsi produk dan panduan pengguna."@id ; ac:group "Evidence" .
ac:Code a owl:Class ; rdfs:label "code"@en ; rdfs:comment "Kode program dan file konfigurasi agent."@id ; ac:group "Evidence" .
ac:Log a owl:Class ; rdfs:label "log"@en ; rdfs:comment "Catatan aktivitas agent saat berjalan."@id ; ac:group "Evidence" .
ac:HumanReview a owl:Class ; rdfs:label "human review"@en ; rdfs:comment "Pemeriksaan compliance risk oleh manusia. Temuannya disimpan sebagai evidence baru."@id ; ac:group "Evidence" .
ac:Framework a owl:Class ; rdfs:label "framework"@en ; rdfs:comment "Dokumen acuan yang memuat kewajiban, misalnya EU AI Act dan IMDA."@id ; ac:group "Regulasi" .
ac:Rule a owl:Class ; rdfs:label "rule"@en ; rdfs:comment "Satu kewajiban dari framework yang ditulis ulang supaya bisa di-check."@id ; ac:group "Regulasi" .
ac:UseArea a owl:Class ; rdfs:label "use area"@en ; rdfs:comment "Area penggunaan yang menentukan risk class, misalnya Annex III poin 5(b)."@id ; ac:group "Regulasi" .
ac:RiskClass a owl:Class ; rdfs:label "risk class"@en ; rdfs:comment "Golongan agent menurut framework, misalnya high-risk di EU AI Act."@id ; ac:group "Regulasi" .
ac:ComplianceRisk a owl:Class ; rdfs:label "compliance risk"@en ; rdfs:comment "Satu masalah pada satu agent untuk satu rule, beserta evidence-nya."@id ; ac:group "Penilaian" .
ac:RiskLevel a owl:Class ; rdfs:label "risk level"@en ; rdfs:comment "Tingkat keparahan compliance risk: Critical, High, Medium, atau Low."@id ; ac:group "Penilaian" .
ac:Documentation rdfs:subClassOf ac:Source .
ac:Code rdfs:subClassOf ac:Source .
ac:Log rdfs:subClassOf ac:Source .
# Kaitan ke PROV-O
ac:Evidence rdfs:subClassOf prov:Entity .
ac:Source rdfs:subClassOf prov:Entity .
ac:Action rdfs:subClassOf prov:Activity .
ac:fromSource rdfs:subPropertyOf prov:wasDerivedFrom .

# Object property
ac:hasTool a owl:ObjectProperty ; rdfs:domain ac:Agent ; rdfs:range ac:Tool ;
    rdfs:label "has tool"@en ; rdfs:comment "Agent punya tool ini."@id .
ac:hasPurpose a owl:ObjectProperty ; rdfs:domain ac:Agent ; rdfs:range ac:Purpose ;
    rdfs:label "has purpose"@en ; rdfs:comment "Purpose agent, diambil dari evidence documentation."@id .
ac:hasRiskClass a owl:ObjectProperty ; rdfs:domain ac:Agent ; rdfs:range ac:RiskClass ;
    rdfs:label "has risk class"@en ; rdfs:comment "Risk class agent. Disimpulkan dari purpose dan UseArea."@id ; ac:inferred true .
ac:callsTool a owl:ObjectProperty ; rdfs:domain ac:Action ; rdfs:range ac:Tool ;
    rdfs:label "calls tool"@en ; rdfs:comment "Action ini memanggil tool tersebut."@id .
ac:inSession a owl:ObjectProperty ; rdfs:domain ac:Action ; rdfs:range ac:Session ;
    rdfs:label "in session"@en ; rdfs:comment "Action ini terjadi di sesi tersebut."@id .
ac:hasApproval a owl:ObjectProperty ; rdfs:domain ac:Action ; rdfs:range ac:Approval ;
    rdfs:label "has approval"@en ; rdfs:comment "Action ini punya approval. Kalau tidak ada, berarti tanpa approval."@id .
ac:about a owl:ObjectProperty ; rdfs:domain ac:Evidence ; rdfs:range [ a owl:Class ; owl:unionOf ( ac:Agent ac:Tool ) ] ;
    rdfs:label "about"@en ; rdfs:comment "Evidence ini membicarakan agent atau tool tersebut."@id .
ac:fromSource a owl:ObjectProperty ; rdfs:domain ac:Evidence ; rdfs:range ac:Source ;
    rdfs:label "from source"@en ; rdfs:comment "File asal evidence. Bersama location membentuk provenance."@id .
ac:fromReview a owl:ObjectProperty ; rdfs:domain ac:Evidence ; rdfs:range ac:HumanReview ;
    rdfs:label "from review"@en ; rdfs:comment "Evidence ini berasal dari human review, bukan dari source."@id .
ac:purpose a owl:ObjectProperty ; rdfs:domain ac:Evidence ; rdfs:range ac:Purpose ;
    rdfs:label "purpose"@en ; rdfs:comment "Purpose agent menurut evidence ini."@id .
ac:fromFramework a owl:ObjectProperty ; rdfs:domain ac:Rule ; rdfs:range ac:Framework ;
    rdfs:label "from framework"@en ; rdfs:comment "Framework asal rule."@id .
ac:appliesToRiskClass a owl:ObjectProperty ; rdfs:domain ac:Rule ; rdfs:range ac:RiskClass ;
    rdfs:label "applies to risk class"@en ; rdfs:comment "Rule berlaku untuk agent dengan risk class ini."@id .
ac:checksProperty a owl:ObjectProperty ; rdfs:domain ac:Rule ; rdfs:range rdf:Property ;
    rdfs:label "checks property"@en ; rdfs:comment "Properti evidence yang dibaca saat check rule ini."@id .
ac:appliesTo a owl:ObjectProperty ; rdfs:domain ac:Rule ; rdfs:range [ a owl:Class ; owl:unionOf ( ac:Agent ac:Tool ) ] ;
    rdfs:label "applies to"@en ; rdfs:comment "Rule berlaku untuk agent atau tool ini. Disimpulkan saat penalaran."@id ; ac:inferred true .
ac:coversPurpose a owl:ObjectProperty ; rdfs:domain ac:UseArea ; rdfs:range ac:Purpose ;
    rdfs:label "covers purpose"@en ; rdfs:comment "UseArea ini mencakup purpose tersebut."@id .
ac:impliesRiskClass a owl:ObjectProperty ; rdfs:domain ac:UseArea ; rdfs:range ac:RiskClass ;
    rdfs:label "implies risk class"@en ; rdfs:comment "Agent di UseArea ini mendapat risk class tersebut."@id .
ac:forAgent a owl:ObjectProperty ; rdfs:domain ac:ComplianceRisk ; rdfs:range ac:Agent ;
    rdfs:label "for agent"@en ; rdfs:comment "Agent yang dinilai."@id .
ac:forRule a owl:ObjectProperty ; rdfs:domain ac:ComplianceRisk ; rdfs:range ac:Rule ;
    rdfs:label "for rule"@en ; rdfs:comment "Rule yang di-check."@id .
ac:basedOn a owl:ObjectProperty ; rdfs:domain ac:ComplianceRisk ; rdfs:range ac:Evidence ;
    rdfs:label "based on"@en ; rdfs:comment "Evidence yang mendasari compliance risk ini."@id .
ac:hasRiskLevel a owl:ObjectProperty ; rdfs:domain ac:ComplianceRisk ; rdfs:range ac:RiskLevel ;
    rdfs:label "has risk level"@en ; rdfs:comment "Risk level compliance risk ini."@id .

# Data property
ac:requiresApproval a owl:DatatypeProperty ; rdfs:domain ac:Evidence ; rdfs:range xsd:boolean ;
    rdfs:label "requires approval"@en ; rdfs:comment "Tool perlu approval atau tidak, menurut evidence ini."@id .
ac:affectsPerson a owl:DatatypeProperty ; rdfs:domain ac:Evidence ; rdfs:range xsd:boolean ;
    rdfs:label "affects person"@en ; rdfs:comment "Tool memutus nasib orang atau tidak, menurut evidence ini."@id .
ac:hasStopControl a owl:DatatypeProperty ; rdfs:domain ac:Evidence ; rdfs:range xsd:boolean ;
    rdfs:label "has stop control"@en ; rdfs:comment "Ada cara bagi manusia untuk menghentikan agent."@id .
ac:logRetentionDays a owl:DatatypeProperty ; rdfs:domain ac:Evidence ; rdfs:range xsd:integer ;
    rdfs:label "log retention days"@en ; rdfs:comment "Berapa hari log disimpan."@id .
ac:oldestEntryDays a owl:DatatypeProperty ; rdfs:domain ac:Evidence ; rdfs:range xsd:integer ;
    rdfs:label "oldest entry days"@en ; rdfs:comment "Umur entri log tertua, dalam hari."@id .
ac:actionsWithoutApproval a owl:DatatypeProperty ; rdfs:domain ac:Evidence ; rdfs:range xsd:integer ;
    rdfs:label "actions without approval"@en ; rdfs:comment "Jumlah action tanpa approval yang ditemukan di log."@id .
ac:location a owl:DatatypeProperty ; rdfs:domain ac:Evidence ; rdfs:range xsd:string ;
    rdfs:label "location"@en ; rdfs:comment "Bagian dari provenance: halaman, baris, atau sesi di dalam file."@id .
ac:confidence a owl:DatatypeProperty ; rdfs:domain ac:Evidence ; rdfs:range xsd:decimal ;
    rdfs:label "confidence"@en ; rdfs:comment "Seberapa yakin extraction benar, dari 0 sampai 1."@id .
ac:atTime a owl:DatatypeProperty ; rdfs:domain ac:Action ; rdfs:range xsd:string ;
    rdfs:label "at time"@en ; rdfs:comment "Waktu action terjadi."@id .
ac:article a owl:DatatypeProperty ; rdfs:domain ac:Rule ; rdfs:range xsd:string ;
    rdfs:label "article"@en ; rdfs:comment "Article atau bagian framework asal rule."@id .
ac:checks a owl:DatatypeProperty ; rdfs:domain ac:Rule ; rdfs:range xsd:string ;
    rdfs:label "checks"@en ; rdfs:comment "Isi check dalam bahasa biasa."@id .
ac:pattern a owl:DatatypeProperty ; rdfs:domain ac:ComplianceRisk ; rdfs:range xsd:string ;
    rdfs:label "pattern"@en ; rdfs:comment "Gabungan hasil check documentation, code, dan log."@id .
ac:reviewStatus a owl:DatatypeProperty ; rdfs:domain ac:ComplianceRisk ; rdfs:range xsd:string ;
    rdfs:label "review status"@en ; rdfs:comment "Status human review."@id .
ac:rank a owl:DatatypeProperty ; rdfs:domain ac:RiskLevel ; rdfs:range xsd:integer ;
    rdfs:label "rank"@en ; rdfs:comment "Urutan keparahan. 1 paling serius."@id .
ac:group a owl:AnnotationProperty ; rdfs:comment "Kelompok konsep di proposal."@id .
ac:inferred a owl:AnnotationProperty ; rdfs:comment "Hubungan ini diisi oleh penalaran, bukan dari source."@id .

# Risk level
ac:Critical a ac:RiskLevel ; ac:rank 1 .
ac:High a ac:RiskLevel ; ac:rank 2 .
ac:Medium a ac:RiskLevel ; ac:rank 3 .
ac:Low a ac:RiskLevel ; ac:rank 4 .
